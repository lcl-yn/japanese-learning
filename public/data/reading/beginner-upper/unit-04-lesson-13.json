                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "森：あのう，すみません。とりあえず　生ビールを　三つ　お願いします　　ーー"
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "#e30000",
                    "fontFamily": "",
                    "fontSize": ""
                  }
