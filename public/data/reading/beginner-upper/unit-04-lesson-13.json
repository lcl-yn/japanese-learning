                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "李さんは　毎日　七時間　働きます　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
