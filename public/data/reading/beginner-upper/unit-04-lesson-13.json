                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　读じかん，表示一段时间"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "李さんは　一週間に　二回　プールへ　行きます　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "に"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　次数、频率。如一週間に二回"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
