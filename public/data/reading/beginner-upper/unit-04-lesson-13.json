                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "小野：これから　森さんと　近くの　お店へ　飲みに　行きます。李さんも　いっしょに　どうですか"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "李：えっ，いいですか。お願いします"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "李：森さんたちは　この　お店へ　よく　来ますか"
