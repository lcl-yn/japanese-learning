                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：電車で　一時間ぐらい　かかります　　ーー"
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "#e30000",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
