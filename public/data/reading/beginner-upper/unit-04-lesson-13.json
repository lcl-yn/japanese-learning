                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：はい。五枚で　二百五十円です　　ーー"
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "#e30000",
                    "fontFamily": "",
                    "fontSize": ""
