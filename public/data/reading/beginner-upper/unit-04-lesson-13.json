                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "午後　郵便局へ　荷物を　出しに　行きます　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "に　行きます"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　去的目的。动词ます形去掉ます，再加に"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
