                {
                  "type": "bold"
                }
              ],
              "text": "乙：いいえ，一度も　ありません。天ぷらは　食べた　ことが　あります"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          }
        },
        {
          "type": "paragraph",
          "attrs": {
