                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "李：言葉は　分かりませんでしたが，とても　よかったです"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "小野：そうですね。課長に　感謝しましょう"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
