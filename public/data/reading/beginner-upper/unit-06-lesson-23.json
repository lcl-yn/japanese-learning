              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "　把疑问嵌进句子，疑问句后加か"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
