                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "日本語の　先生は　中国人だったり　日本人だったりです　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
