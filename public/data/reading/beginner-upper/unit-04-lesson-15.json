                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：いえ，ちょっと．．．。今　使って　います"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          }
        },
        {
          "type": "paragraph",
          "attrs": {
