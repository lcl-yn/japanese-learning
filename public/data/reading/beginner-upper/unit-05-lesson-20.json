              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "#e30000",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "よね"
