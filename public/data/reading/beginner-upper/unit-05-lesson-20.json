                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "森：じゃあ，いっしょに　どこかへ　行きませんか"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
