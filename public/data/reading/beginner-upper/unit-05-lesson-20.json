                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "李：ええ。北京では　春節の　前に，家族みんなで　ギョーザを　作ります"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
