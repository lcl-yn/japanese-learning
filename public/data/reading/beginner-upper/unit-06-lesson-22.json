                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "森さんは　毎晩　テレビを　見る　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "見る"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　简体现在肯定，朋友之间用。句尾不加ます"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "昨日は　とても　忙しかった　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "忙しかった"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　简体过去。一类形容词去い加かった，不加です"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "コンピュータは　簡単では　ない　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "では　ない"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　简体的ではありません"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "今日は　曇りだ　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "だ"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　简体的です"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "textAlign": null
      }
    },
    {
      "type": "blockquote",
      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "甲：明日　ボーリングに　行かない？"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：ごめん。明日は　仕事が　あるから…"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "甲：昨日の　試験，どうだった？"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：ちょっと　難しかったけど，まあまあ　できたよ　　ーー"
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "#e30000",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "けど"
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "　口语里的“但是”或铺垫，前面用简体"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "甲：この　ネクタイ，派手？"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：ううん，全然　派手じゃないわ"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "甲：森さんの　電話番号，知ってる？"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：うん，知ってる。３４９３－３９４５だよ"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "textAlign": null
      }
    },
