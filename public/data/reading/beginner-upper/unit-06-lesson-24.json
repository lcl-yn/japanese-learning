                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "李さんは　もう　すぐ　来ると　思います　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "と思います"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　我觉得。前面用简体"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "陳さんは　パーティーに　行くと　言いました　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "と言いました"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　转述别人的话。前面用简体"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "すみません，頭が　痛いんです　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "んです"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　说明情况或理由。问原因时说どうして～んですか"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "東京タワーへ　行きたいんですが，どうやって　行きますか　　ーー"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#e30000",
                            "fontFamily": "",
                            "fontSize": ""
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "が"
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "textStyle",
                          "attrs": {
                            "color": "#000000",
                            "fontFamily": null,
                            "fontSize": null
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ],
                      "text": "　先说出前提，再引出请求或问题"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "textAlign": null
      }
    },
    {
      "type": "blockquote",
      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "甲：日本の　音楽に　ついて　どう　思いますか"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：すばらしいと　思います"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "甲：課長は　何と　言いましたか"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：午後から　出かけると　言いました"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "甲：どうして　食べないんですか"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：もう　おなかが　いっぱいなんです"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "甲：李さんを　さがして　いるんですが，どこに　いますか"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": "rgb(0, 0, 0)",
                    "fontFamily": "",
                    "fontSize": ""
                  }
                },
                {
                  "type": "bold"
                }
              ],
              "text": "乙：会議室に　いると　思います"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "textAlign": null
      }
    },
    {
